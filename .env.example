DATABASE_URL=postgresql+psycopg://familyos:familyos@localhost:5435/familyos
# SQLAlchemy connection pool (PostgreSQL). Defaults shown.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
# REQUIRED — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Base URL of the web app (used in invitation links). Match your client origin.
PUBLIC_APP_URL=http://localhost:3000
# log = stdout stub only; real providers can be added later
EMAIL_PROVIDER=log
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
# Prefer the short raw key from: python -m scripts.print_vapid_env
# (Do not paste PEM into PaaS env — pywebpush cannot load PEM strings.)
# REQUIRED for web push — must be mailto: or https: (mailto: is normalized if bare email)
VAPID_CONTACT_EMAIL=mailto:admin@familyos.app
ENVIRONMENT=development
# Receipt scanning (OpenAI vision). Leave empty to disable extraction.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
RECEIPT_SCANNING_ENABLED=true
ASSISTANT_ENABLED=true
RECEIPT_STORAGE_DIR=var/receipts
RECEIPT_MAX_BYTES=10485760
