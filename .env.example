DATABASE_URL=postgresql+psycopg://familyos:familyos@localhost:5435/familyos
# REQUIRED — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Base URL of the web app (used in invitation links). Match your client origin.
PUBLIC_APP_URL=http://localhost:3000
# log = stdout stub only; real providers can be added later
EMAIL_PROVIDER=log
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
# Prefer base64url:… of private_key.pem in PaaS env UIs (avoids + → space corruption).
# Generate both values: python -m scripts.print_vapid_env
# REQUIRED for web push — must be mailto: or https: (mailto: is normalized if bare email)
VAPID_CONTACT_EMAIL=mailto:admin@familyos.app
ENVIRONMENT=development
